{
  "name": "agentic-e2e",
  "version": "0.1.0",
  "description": "LLM-driven end-to-end test discovery, generation and self-healing on Playwright",
  "type": "module",
  "bin": {
    "agentic-e2e": "./bin/agentic-e2e.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && pnpm web:build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "tsx scripts/check-tracked-secrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/credential-providers": "^3.1164.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@playwright/test": "^1.65.0",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.8",
    "jiti": "^2.7.0",
    "pino": "^10.4.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
