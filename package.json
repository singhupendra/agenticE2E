{
  "name": "agentic-e2e",
  "version": "0.1.0",
  "description": "LLM-driven end-to-end test discovery, generation and self-healing on Playwright",
  "type": "module",
  "bin": {
    "agentic-e2e": "./bin/agentic-e2e.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "server": "tsx src/server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && pnpm web:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/static": "^10.1.10",
    "@playwright/test": "^1.65.0",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.8",
    "jiti": "^2.7.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
